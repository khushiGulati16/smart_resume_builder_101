<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard - ResumeHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root {
      --bg-gradient: linear-gradient(135deg, #0f172a, #1e293b);
      --text-light: #f1f5f9;
      --muted: #cbd5e1;
      --accent: #6366f1;
      --accent-glow: #8b5cf6;
      --card-bg: rgba(30, 41, 59, 0.8);
      --shadow: 0 10px 25px rgba(0,0,0,0.6);
      --radius: 16px;
      --font: 'Poppins', 'Segoe UI', sans-serif;
    }

    body.dashboard-page {
      font-family: var(--font);
      background: var(--bg-gradient);
      color: var(--text-light);
      padding-top: 80px;
      margin: 0;
    }

    .navbar {
      position: fixed;
      top: 0;
      width: 100%;
      padding: 1rem 4rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.05);
      box-shadow: var(--shadow);
      z-index: 1000;
    }
    .navbar .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--accent);
      text-decoration: none;
    }
    .navbar .logo img {
      width: 38px;
      height: 38px;
      object-fit: cover;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.4);
    }
    .navbar nav a {
      margin-left: 2rem;
      font-weight: 500;
      text-decoration: none;
      color: var(--text-light);
      position: relative;
      transition: color 0.3s ease;
    }
    .navbar nav a:hover { color: var(--accent); }
    .navbar nav a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 0;
      height: 2px;
      background: var(--accent);
      transition: width 0.3s ease;
    }
    .navbar nav a:hover::after { width: 100%; }

    .admin-grid {
      max-width: 1200px;
      margin: 2rem auto;
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 1.5rem;
      padding: 0 2rem;
    }

    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 1.25rem;
      box-shadow: var(--shadow);
    }

    /* 🔥 Make sure all text inside cards is light, not black */
    .card,
    .card h1, .card h2, .card h3, .card h4, .card h5, .card h6,
    .card p, .card span, .card li, .card strong {
      color: var(--text-light);
    }

    .stat-row { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1rem; }
    .stat { flex:1 1 160px; padding:1rem; border-radius:10px; background: rgba(255,255,255,0.02); text-align:center; }
    .stat h2 { margin:0; font-size:1.6rem; color: #fff; }
    .stat p { margin:0; color:var(--muted); }

    .small-list { max-height:420px; overflow:auto; margin-top:1rem; }
    .small-list ul { list-style:none; padding:0; margin:0; }
    .small-list li { padding:12px 0; border-bottom: 1px dashed rgba(255,255,255,0.03); }

    .aside-card { margin-bottom:1rem; }

    .btn-mini {
      padding:6px 10px;
      border-radius:8px;
      font-size:0.9rem;
      text-decoration:none;
      display:inline-block;
      color:#fff;
    }
    .btn-primary {
      background: linear-gradient(45deg, var(--accent), var(--accent-glow));
      color:#fff;
      padding:8px 14px;
      border-radius:8px;
      text-decoration:none;
      border:none;
      cursor:pointer;
    }
    .search-input {
      width:100%;
      padding:8px 10px;
      border-radius:8px;
      border:none;
      background: rgba(255,255,255,0.03);
      color:var(--text-light);
    }

    .footer {
      text-align:center;
      padding:2rem;
      margin-top:2rem;
      color:var(--muted);
      background: rgba(15,23,42,0.85);
    }

    @media (max-width: 900px) {
      .admin-grid { grid-template-columns: 1fr; padding: 1rem; }
    }
  </style>
</head>
<body class="dashboard-page">

  <header class="navbar">
      <a href="/" class="logo">
        ResumeHub
      </a>

      <nav>
          <a href="/admin">Home</a>
          <a href="/admin/users">Admin Users</a>
          <a href="/admin/resumes">Admin Resumes</a>
          <a href="/ats">ATS Checker</a>
          <a href="/auth/logout">Logout</a>
      </nav>
  </header>

  <div style="padding-top:100px;"></div>

  <div class="admin-grid">
    <div>
      <div class="card">
        <h1>Admin Dashboard</h1>
        <p style="color:var(--muted); margin-top:6px;">Overview and quick actions for administrators.</p>

        <div class="stat-row">
          <div class="stat">
            <h2><%= stats.usersCount %></h2>
            <p>Registered users</p>
          </div>
          <div class="stat">
            <h2><%= stats.resumesCount %></h2>
            <p>Total resumes</p>
          </div>
          <div class="stat">
            <h2><%= stats.templatesUsed %></h2>
            <p>Templates used</p>
          </div>
          <div class="stat">
            <h2><%= stats.recent24h %></h2>
            <p>Resumes last 24h</p>
          </div>
        </div>

        <div style="margin-top:12px;">
          <a href="/admin/users" class="btn-mini" style="background:#3b82f6;">Manage Users</a>
          <a href="/admin/resumes" class="btn-mini" style="background:#10b981;margin-left:8px;">View All Resumes</a>
          <a href="/ats" class="btn-mini" style="background:#6366f1;margin-left:8px;">ATS Checker</a>
        </div>
      </div>

      <div class="card" style="margin-top:1rem;">
        <h3>Recent Resumes</h3>
        <div class="small-list">
          <% if (recentResumes && recentResumes.length) { %>
            <ul>
              <% recentResumes.forEach(r => { %>
                <li>
                  <strong><%= r.name %></strong>
                  <div style="font-size:0.9rem; color:var(--muted); margin-top:4px;">
                    <%= r.role %> · <%= new Date(r.createdAt).toLocaleString() %><br>
                    Owner: <%= r.userId ? r.userId.name + ' ('+ r.userId.email +')' : 'Unknown' %>
                  </div>
                  <div style="margin-top:8px;">
                    <a class="btn-mini" href="/resume/<%= r._id %>" target="_blank" style="background:#111827;">View</a>
                    <a class="btn-mini" href="/resume/<%= r._id %>/download" style="background:#2563eb; margin-left:6px;">Download</a>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p style="color:var(--muted)">No recent resumes available.</p>
          <% } %>
        </div>
      </div>
    </div>

    <aside>
      <div class="card aside-card">
        <h3>Quick User Search</h3>
        <form action="/admin/users" method="GET" style="margin-top:8px;">
          <input class="search-input" name="q" placeholder="search name or email">
          <button class="btn-primary" style="width:100%; margin-top:8px;">Search</button>
        </form>
      </div>

      <div class="card aside-card">
        <h3>Platform Activity</h3>
        <p style="color:var(--muted)">Online users: <strong id="online-count">0</strong></p>
        <p style="color:var(--muted)">Last 7 days resumes: <strong><%= stats.last7Days %></strong></p>
        <p style="color:var(--muted)">Most used template: <strong><%= stats.mostUsedTemplate || '—' %></strong></p>
      </div>

      <div class="card aside-card">
        <h3>Admin Notes</h3>
        <p style="color:var(--muted)">Use the Admin Resumes / Users pages for moderation and bulk actions.</p>
      </div>
    </aside>
  </div>

  <footer class="footer">
    <p>&copy; 2025 Smart Resume Builder. Admin Panel.</p>
  </footer>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    socket.on('online:count', (count) => {
      const el = document.getElementById('online-count');
      if (el) el.textContent = count;
    });

   
    socket.on('resume:created', (data) => {
      console.log('resume created', data);
    });
  </script>
</body>
</html>
