<!DOCTYPE html>
<html>
<head>
  <title>Edit Resume - <%= resume.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root {
      --bg-gradient: linear-gradient(135deg, #0f172a, #1e293b);
      --text-light: #f1f5f9;
      --muted: #cbd5e1;
      --accent: #6366f1;
      --accent-glow: #8b5cf6;
      --card-bg: rgba(30, 41, 59, 0.85);
      --shadow: 0 10px 25px rgba(0,0,0,0.6);
      --radius: 16px;
      --font: 'Poppins', 'Segoe UI', sans-serif;
    }

    body.main-page {
      font-family: var(--font);
      background: var(--bg-gradient);
      color: var(--text-light);
      margin: 0;
      padding-top: 80px;
    }

    /* Navbar */
    .navbar {
      position: fixed;
      top: 0;
      width: 100%;
      padding: 1rem 4rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.05);
      box-shadow: var(--shadow);
      z-index: 1000;
    }

    .navbar .logo {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--accent);
      text-decoration: none;
    }

    .navbar nav a {
      margin-left: 2rem;
      font-weight: 500;
      text-decoration: none;
      color: var(--text-light);
      position: relative;
      transition: color 0.3s ease;
    }

    .navbar nav a:hover {
      color: var(--accent);
    }

    .navbar nav a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 0;
      height: 2px;
      background: var(--accent);
      transition: width 0.3s ease;
    }

    .navbar nav a:hover::after {
      width: 100%;
    }

    /* Form Container */
    .form-container {
      max-width: 900px;
      margin: 2rem auto;
      background: var(--card-bg);
      padding: 30px;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .form-title {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 10px;
      background: linear-gradient(90deg, var(--accent), var(--accent-glow));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-align: center;
    }

    .subtitle {
      font-size: 1rem;
      color: var(--muted);
      text-align: center;
      margin-bottom: 20px;
    }

    form.resume-form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    form.resume-form label {
      font-weight: 500;
    }

    form.resume-form input,
    form.resume-form textarea {
      padding: 10px;
      border-radius: 8px;
      border: none;
      font-size: 0.95rem;
      background: rgba(255,255,255,0.05);
      color: var(--text-light);
      resize: vertical;
    }

    form.resume-form input::placeholder,
    form.resume-form textarea::placeholder {
      color: var(--muted);
    }

    form.resume-form button[type="submit"] {
      margin-top: 15px;
      background: linear-gradient(45deg, var(--accent), var(--accent-glow));
      color: #fff;
      padding: 12px 25px;
      font-weight: 600;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    form.resume-form button[type="submit"]:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(139,92,246,0.6);
    }

    /* Template selection */
    .template-selection h2 {
      font-size: 1.1rem;
      margin-bottom: 10px;
    }

    .template-previews {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .preview-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: rgba(255,255,255,0.05);
      padding: 10px;
      border-radius: var(--radius);
      cursor: pointer;
      flex: 1 0 150px;
      text-align: center;
    }

    .preview-box input {
      display: none;
    }

    .preview-box img {
      width: 100%;
      border-radius: 8px;
      margin-bottom: 5px;
    }

    .preview-box .preview-title {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .preview-box input:checked + img + .preview-title {
      color: var(--accent);
      font-weight: 600;
    }

    /* Preview card */
    .footer {
      text-align: center;
      padding: 2rem;
      background: rgba(15,23,42,0.85);
      border-top: 1px solid rgba(255,255,255,0.05);
      margin-top: 3rem;
      font-size: 0.95rem;
      color: var(--muted);
    }

    @media(max-width: 768px){
      .template-previews {
        flex-direction: column;
      }
    }
  </style>
</head>
<body class="main-page">
  <header class="navbar">
    <a href="/" class="logo">ResumeHub</a>
    <nav>
      <a href="/">Home</a>
      <a href="/resume/create">Create New</a>
      <a href="/dashboard">My Resumes</a>
      <a href="/ats">ATS Checker</a>
      <a href="/auth/logout">Logout</a>
    </nav>
  </header>

  <div class="form-container">
    <h1 class="form-title">Edit Resume: <%= resume.name %></h1>
    <p class="subtitle">Update your details below and save your changes.</p>

    <form action="/resume/<%= id %>/edit" method="POST" class="resume-form">
      <label for="name">Full Name</label>
      <input type="text" id="name" name="name" value="<%= resume.name %>" required>

      <label for="role">Role / Job Title</label>
      <input type="text" id="role" name="role" value="<%= resume.role %>" required>

      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= resume.email %>" required>

      <label for="phone">Phone Number</label>
      <input type="tel" id="phone" name="phone" value="<%= resume.phone %>">

      <label for="address">Address</label>
      <input type="text" id="address" name="address" value="<%= resume.address %>">

      <label for="linkedin">LinkedIn Profile URL</label>
      <input type="url" id="linkedin" name="linkedin" value="<%= resume.linkedin %>">

      <!-- ✅ NEW: Summary -->
      <label for="summary">Professional Summary</label>
      <textarea id="summary" name="summary"><%= resume.summary || "" %></textarea>

      <label for="education">Education</label>
      <textarea id="education" name="education"><%= resume.education %></textarea>

      <label for="experience1">Work Experience 1</label>
      <textarea id="experience1" name="experience1"><%= resume.experience1 %></textarea>

      <label for="experience2">Work Experience 2</label>
      <textarea id="experience2" name="experience2"><%= resume.experience2 %></textarea>

      <label for="experience3">Work Experience 3</label>
      <textarea id="experience3" name="experience3"><%= resume.experience3 %></textarea>

      <!-- ✅ NEW: Projects / Certifications -->
      <label for="projects">Projects / Certifications / Awards</label>
      <textarea id="projects" name="projects"><%= resume.projects || "" %></textarea>

      <label for="skills">Skills</label>
      <textarea id="skills" name="skills"><%= resume.skills %></textarea>

      <div class="template-selection">
        <h2>Choose your template:</h2>
        <div class="template-previews">
          <% ['template1','template2','template3','template4','template5','template6','template7','template8','template9','template10'].forEach(t => { %>
            <label class="preview-box">
              <input type="radio" name="template" value="<%= t %>" <%= resume.template === t ? 'checked' : '' %> >
              <img src="/images/<%= t %>-preview.png" alt="<%= t %> Preview" class="preview-img">
              <span class="preview-title"><%= t.replace('template','Template ') %></span>
            </label>
          <% }) %>
        </div>
      </div>

      <button type="submit">Update Resume</button>
    </form>

    <div style="margin-top: 2rem; padding: 1.5rem; border-radius: 16px; background: rgba(15,23,42,0.7); box-shadow: 0 10px 25px rgba(0,0,0,0.6);">
      <h2 style="margin-bottom: 0.5rem;">Live Preview</h2>
      <p id="preview-name" style="font-size: 1.4rem; font-weight: 700;"><%= resume.name %></p>
      <p id="preview-role" style="font-size: 1rem; opacity: 0.9;"><%= resume.role %></p>
      <p style="margin-top: 0.5rem;">
        <strong>Skills:</strong>
        <span id="preview-skills"><%= resume.skills %></span>
      </p>
    </div>
  </div>

  <footer class="footer">
    <p>&copy; 2025 Smart Resume Builder. All rights reserved.</p>
  </footer>
</body>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const resumeId = "<%= id %>";

  // join room for this resume
  socket.emit("resume:join", resumeId);

  // update preview when other events arrive (or echo updates)
  socket.on("resume:preview", (data) => {
    if (!data || data.resumeId !== resumeId) return;
    if (data.field === "name") {
      document.getElementById("preview-name").innerText = data.value || "Your Name";
    }
    if (data.field === "role") {
      document.getElementById("preview-role").innerText = data.value || "Your Role";
    }
    if (data.field === "skills") {
      document.getElementById("preview-skills").innerText = data.value || "Skills";
    }
  });

  // send updates when user types
  document.querySelectorAll(".resume-form input, .resume-form textarea").forEach((el) => {
    el.addEventListener("input", (e) => {
      socket.emit("resume:update", {
        resumeId,
        field: e.target.name,
        value: e.target.value,
      });
    });
  });
</script>
</html>
