<!DOCTYPE html>
<html>
<head>
    <title><%= resume.name %> - Resume</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        :root {
            --t10-text: #111827;
            --t10-muted: #6b7280;
            --t10-border: #e5e7eb;
            --font: 'Poppins', 'Segoe UI', sans-serif;
        }

        body.template {
            font-family: var(--font);
            background: #0f172a;
            margin: 0;
            padding-top: 80px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Navbar */
        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(15,23,42,0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            z-index: 1000;
        }
        .navbar .logo {
            font-size: 1.6rem;
            font-weight: 700;
            color: #6366f1;
            text-decoration: none;
        }
        .navbar nav a {
            margin-left: 2rem;
            font-weight: 500;
            color: #e5e7eb;
            text-decoration: none;
        }

        /* Main Sheet */
        .template10-resume {
            width: 210mm;
            min-height: 297mm;
            padding: 32px 40px 40px;
            margin: 40px auto;
            background: white;
            border-radius: 4px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.4);
            box-sizing: border-box;
        }

        /* Header */
        .t10-header {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 14px;
        }
        .t10-header h1 {
            font-size: 2.3rem;
            text-transform: uppercase;
            margin: 0;
        }
        .t10-header h2 {
            margin: 0;
            font-size: 1rem;
            color: var(--t10-muted);
            text-transform: uppercase;
        }
        .t10-contact-block {
            text-align: right;
            font-size: 0.85rem;
            color: var(--t10-muted);
        }

        /* Summary */
        .t10-summary {
            margin-top: 10px;
            font-size: 0.9rem;
            line-height: 1.6;
            color: #374151;
        }

        /* Section Formatting */
        .t10-section {
            margin-top: 24px;
        }
        .t10-section-title {
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .t10-section-divider {
            height: 1px;
            background: var(--t10-border);
            width: 100%;
            margin-bottom: 10px;
        }

        /* Experience */
        .t10-exp-role {
            font-size: 0.95rem;
            font-weight: 600;
            margin-bottom: 2px;
            text-transform: uppercase;
        }
        .t10-exp-meta {
            color: var(--t10-muted);
            font-size: 0.85rem;
            margin-bottom: 4px;
        }
        .t10-exp-list {
            font-size: 0.9rem;
            line-height: 1.6;
            color: #374151;
            margin: 4px 0 10px;
            padding-left: 18px;
        }

        /* Education */
        .t10-edu-line {
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* Skills */
        .t10-skills-grid {
            flex-wrap: wrap;
            display: flex;
            gap: 8px 24px;
            font-size: 0.9rem;
        }
        .t10-skill-item::before {
            content: "• ";
        }

        /* Projects / Certifications */
        .t10-project-list {
            padding-left: 18px;
            margin: 4px 0 10px;
        }
        .t10-project-list li {
            font-size: 0.9rem;
            line-height: 1.6;
            color: #374151;
        }

        /* Download button */
        .download-button-ui {
            margin-top: 1.5rem;
            display: inline-block;
            padding: 12px 25px;
            border-radius: 999px;
            background: linear-gradient(45deg,#6366f1,#4f46e5);
            color: white;
            text-decoration: none;
            font-weight: 600;
        }

        @media print {
            .navbar, .download-button-ui { display: none !important; }
            body.template { padding-top: 0; background: white; }
            .template10-resume { margin: 0; box-shadow: none; }
        }
    </style>
</head>

<body class="template template10">

<header class="navbar">
    <a href="/" class="logo">ResumeHub</a>

    <nav>
        <% if (user && user.role === "admin") { %>
            <a href="/admin">Admin Dashboard</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/resumes">All Resumes</a>
            <a href="/ats">ATS Checker</a>
            <a href="/auth/logout">Logout</a>
        <% } else { %>
            <a href="/">Home</a>
            <a href="/resume/create">Create New</a>
            <a href="/dashboard">My Resumes</a>
            <a href="/ats">ATS Checker</a>
            <a href="/auth/logout">Logout</a>
        <% } %>
    </nav>
</header>


<div class="template10-resume main-resume-container">

    <!-- HEADER -->
    <div class="t10-header">
        <div>
            <h1><%= resume.name %></h1>
            <h2><%= resume.role %></h2>
        </div>

        <div class="t10-contact-block">
            <% if (resume.address) { %><div><%= resume.address %></div><% } %>
            <% if (resume.phone) { %><div><%= resume.phone %></div><% } %>
            <% if (resume.email) { %><div><%= resume.email %></div><% } %>
            <% if (resume.linkedin) { %><div><%= resume.linkedin %></div><% } %>
        </div>
    </div>

    <!-- SUMMARY -->
    <p class="t10-summary">
        <% if (resume.summary && resume.summary.trim().length > 0) { %>
            <%= resume.summary %>

        <% } else if (resume.skills && resume.skills.trim().length > 0) { %>
            <%= resume.role %> experienced in <%= resume.skills %>. Focused on delivering high-quality work, problem-solving and achieving measurable outcomes.

        <% } else { %>
            <%= resume.role %> focused on delivering high-quality work and achieving measurable outcomes.
        <% } %>
    </p>

    <!-- EXPERIENCE -->
    <section class="t10-section">
        <div class="t10-section-title">EXPERIENCE</div>
        <div class="t10-section-divider"></div>

        <% if (resume.experience1) { %>
            <div>
                <p class="t10-exp-role">Experience 1</p>
                <p class="t10-exp-meta">Responsibilities & Achievements:</p>
                <ul class="t10-exp-list">
                    <% resume.experience1.split("\n").forEach(line => { %>
                        <% if (line.trim().length > 0) { %><li><%= line.trim() %></li><% } %>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <% if (resume.experience2) { %>
            <div>
                <p class="t10-exp-role">Experience 2</p>
                <p class="t10-exp-meta">Responsibilities & Achievements:</p>
                <ul class="t10-exp-list">
                    <% resume.experience2.split("\n").forEach(line => { %>
                        <% if (line.trim().length > 0) { %><li><%= line.trim() %></li><% } %>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <% if (resume.experience3) { %>
            <div>
                <p class="t10-exp-role">Experience 3</p>
                <p class="t10-exp-meta">Responsibilities & Achievements:</p>
                <ul class="t10-exp-list">
                    <% resume.experience3.split("\n").forEach(line => { %>
                        <% if (line.trim().length > 0) { %><li><%= line.trim() %></li><% } %>
                    <% }) %>
                </ul>
            </div>
        <% } %>
    </section>

    <!-- EDUCATION -->
    <section class="t10-section">
        <div class="t10-section-title">EDUCATION</div>
        <div class="t10-section-divider"></div>

        <% if (resume.education) { %>
            <p class="t10-edu-line"><%= resume.education %></p>
        <% } else { %>
            <p class="t10-edu-line">Education details not provided.</p>
        <% } %>
    </section>

    <!-- SKILLS -->
    <section class="t10-section">
        <div class="t10-section-title">SKILLS</div>
        <div class="t10-section-divider"></div>

        <% if (resume.skills) { %>
            <div class="t10-skills-grid">
                <% resume.skills.split(",").forEach(skill => { %>
                    <% if (skill.trim().length > 0) { %>
                        <span class="t10-skill-item"><%= skill.trim() %></span>
                    <% } %>
                <% }) %>
            </div>
        <% } else { %>
            <p class="t10-exp-text">Skills not specified.</p>
        <% } %>
    </section>

    <!-- PROJECTS / CERTIFICATIONS -->
    <section class="t10-section">
        <div class="t10-section-title">PROJECTS / CERTIFICATIONS</div>
        <div class="t10-section-divider"></div>

        <% if (resume.projects && resume.projects.trim().length > 0) { %>
            <ul class="t10-project-list">
                <% resume.projects.split("\n").forEach(line => { %>
                    <% if (line.trim().length > 0) { %>
                        <li><%= line.trim() %></li>
                    <% } %>
                <% }) %>
            </ul>
        <% } else { %>
            <p class="t10-exp-text">No projects or certifications provided.</p>
        <% } %>
    </section>

</div>

<a href="/resume/<%= id %>/download" class="download-button-ui">Download as PDF</a>

</body>
</html>
