<!DOCTYPE html>
<html>
<head>
    <title><%= resume.name %> - Resume</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a, #1e293b);
            --text-light: #f1f5f9;
            --muted: #cbd5e1;
            --accent: #6366f1;
            --accent-glow: #8b5cf6;
            --card-bg: rgba(30, 41, 59, 0.8);
            --shadow: 0 10px 25px rgba(0,0,0,0.6);
            --radius: 16px;
            --font: 'Poppins', 'Segoe UI', sans-serif;
        }

        body.template {
            font-family: var(--font);
            background: var(--bg-gradient);
            color: #333; /* Default body text color for contrast */
            padding-top: 80px; /* Added padding to accommodate the fixed navbar */
            padding-bottom: 2rem;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Navbar */
        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            box-shadow: var(--shadow);
            z-index: 1000;
        }
        .navbar .logo {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--accent);
            text-decoration: none;
        }
        .navbar nav a {
            margin-left: 2rem;
            font-weight: 500;
            text-decoration: none;
            color: var(--text-light);
            position: relative;
            transition: color 0.3s ease;
        }
        .navbar nav a:hover {
            color: var(--accent);
        }
        .navbar nav a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -4px;
            width: 0;
            height: 2px;
            background: var(--accent);
            transition: width 0.3s ease;
        }
        .navbar nav a:hover::after {
            width: 100%;
        }

        .main-resume-container {
            /* Main layout styles live in your external stylesheet */
        }

        .download-button {
            display: inline-block;
            margin-top: 2rem;
            padding: 12px 25px;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            color: #fff;
            background: linear-gradient(45deg, var(--accent), var(--accent-glow));
            box-shadow: 0 5px 20px rgba(99,102,241,0.5);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .download-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(139,92,246,0.6);
        }

        @media print {
            .navbar, .download-button {
                display: none !important;
            }
            body.template {
                padding-top: 0;
                background: none;
            }
            .main-resume-container {
                box-shadow: none;
            }
        }
    </style>
</head>
<body class="template template3">
<header class="navbar">
    <a href="/" class="logo">ResumeHub</a>

    <nav>
        <% if (user && user.role === "admin") { %>
            <a href="/admin">Admin Dashboard</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/resumes">All Resumes</a>
            <a href="/ats">ATS Checker</a>
            <a href="/auth/logout">Logout</a>
        <% } else { %>
            <a href="/">Home</a>
            <a href="/resume/create">Create New</a>
            <a href="/dashboard">My Resumes</a>
            <a href="/ats">ATS Checker</a>
            <a href="/auth/logout">Logout</a>
        <% } %>
    </nav>
</header>


<div class="resume-creative main-resume-container">
    <div class="left-panel">
        <h1><%= resume.name %></h1>
        <p class="role-title"><%= resume.role %></p>

        <section class="panel-section">
            <h3>Contact</h3>
            <p><%= resume.email %></p>
            <p><%= resume.phone %></p>
            <p><%= resume.address %></p>
            <p><%= resume.linkedin %></p>
        </section>

        <section class="panel-section">
            <h3>Skills</h3>
            <ul>
                <% resume.skills.split(",").forEach(skill => { %>
                    <li><%= skill.trim() %></li>
                <% }) %>
            </ul>
        </section>
    </div>

    <div class="right-panel">
        <% if (resume.summary) { %>
            <section>
                <h2>Summary</h2>
                <p><%= resume.summary %></p>
            </section>
        <% } %>

        <section>
            <h2>Education</h2>
            <p><%= resume.education %></p>
        </section>

        <section>
            <h2>Work Experience</h2>
            <% if (resume.experience1) { %>
                <p><%= resume.experience1 %></p>
            <% } %>
            <% if (resume.experience2) { %>
                <p><%= resume.experience2 %></p>
            <% } %>
            <% if (resume.experience3) { %>
                <p><%= resume.experience3 %></p>
            <% } %>
        </section>

        <% if (resume.projects) { %>
            <section>
                <h2>Projects / Certifications</h2>
                <p><%= resume.projects %></p>
            </section>
        <% } %>
    </div>
</div>

<a href="/resume/<%= id %>/download" class="download-button">Download as PDF</a>

</body>
</html>
