<!DOCTYPE html>
<html>
<head>
    <title><%= resume.name %> - Resume</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --t7-green: #145c4a;
            --t7-green-dark: #0b3b30;
            --t7-bg: #f5f5f5;
            --t7-text: #222222;
            --t7-muted: #666666;
            --t7-border: #e5e7eb;
            --font: 'Poppins', 'Segoe UI', sans-serif;
        }

        body.template {
            font-family: var(--font);
            background: #0f172a;
            margin: 0;
            padding-top: 80px; /* navbar height */
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Navbar (same style family) */
        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            z-index: 1000;
        }
        .navbar .logo {
            font-size: 1.6rem;
            font-weight: 700;
            color: #22c55e;
            text-decoration: none;
        }
        .navbar nav a {
            margin-left: 2rem;
            font-weight: 500;
            text-decoration: none;
            color: #e5e7eb;
            position: relative;
            transition: color 0.3s ease;
        }
        .navbar nav a:hover {
            color: #bbf7d0;
        }
        .navbar nav a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -4px;
            width: 0;
            height: 2px;
            background: #22c55e;
            transition: width 0.3s ease;
        }
        .navbar nav a:hover::after {
            width: 100%;
        }

        /* MAIN RESUME CARD */
        .template7-resume {
            width: 210mm;
            min-height: 297mm;
            margin: 40px auto;
            background: #ffffff;
            box-shadow: 0 12px 40px rgba(0,0,0,0.45);
            border-radius: 6px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Top green header with name & role */
        .t7-header {
            background: var(--t7-green);
            color: #ffffff;
            text-align: center;
            padding: 26px 30px 20px;
            border-bottom: 3px solid var(--t7-green-dark);
        }
        .t7-header h1 {
            margin: 0;
            font-size: 2.2rem;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        .t7-header h2 {
            margin: 6px 0 0;
            font-size: 1rem;
            font-weight: 400;
            letter-spacing: 1px;
        }

        /* Main two-column layout */
        .t7-body {
            display: flex;
            flex: 1;
            background: var(--t7-bg);
        }

        .t7-left {
            width: 30%;
            background: #f8fafc;
            border-right: 1px solid var(--t7-border);
            padding: 25px 22px 30px;
            box-sizing: border-box;
        }

        .t7-right {
            width: 70%;
            padding: 25px 35px 35px;
            box-sizing: border-box;
            background: #ffffff;
        }

        .t7-section-title {
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .t7-left .t7-section-title {
            text-align: left;
        }

        .t7-divider {
            height: 2px;
            background: var(--t7-green);
            margin-bottom: 12px;
        }

        .t7-contact-line {
            font-size: 0.9rem;
            color: var(--t7-muted);
            margin-bottom: 6px;
            word-break: break-word;
        }

        .t7-edu-degree {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 3px;
        }
        .t7-edu-meta {
            font-size: 0.85rem;
            color: var(--t7-muted);
            margin-bottom: 10px;
        }

        .t7-skill-list {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }
        .t7-skill-list li {
            font-size: 0.9rem;
            color: var(--t7-text);
            margin-bottom: 4px;
        }

        /* Right side – text blocks */
        .t7-right h3 {
            margin: 0 0 2px;
            font-size: 1.05rem;
        }
        .t7-right .t7-job-meta {
            font-size: 0.85rem;
            color: var(--t7-muted);
            margin-bottom: 4px;
        }
        .t7-right .t7-exp-block {
            margin-bottom: 14px;
        }
        .t7-right ul {
            padding-left: 20px;
            margin: 4px 0 10px;
        }
        .t7-right li {
            font-size: 0.9rem;
            color: #444;
            line-height: 1.6;
        }

        .t7-right .t7-section-title {
            margin-bottom: 6px;
        }
        .t7-right-top-divider {
            height: 2px;
            background: #111827;
            margin-bottom: 10px;
        }

        .t7-summary-text {
            font-size: 0.9rem;
            color: #444;
            line-height: 1.6;
            margin-top: 4px;
        }

        /* Download button in UI, hidden in PDF */
        .download-button-ui {
            display: inline-block;
            margin-top: 1.5rem;
            padding: 12px 25px;
            border-radius: 999px;
            font-weight: 600;
            text-decoration: none;
            color: #fff;
            background: linear-gradient(45deg, #22c55e, #16a34a);
            box-shadow: 0 5px 20px rgba(34,197,94,0.45);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .download-button-ui:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(22,163,74,0.6);
        }

        @media print {
            .navbar,
            .download-button-ui {
                display: none !important;
            }
            body.template {
                padding-top: 0;
                background: #ffffff;
            }
            .template7-resume {
                margin: 0;
                box-shadow: none;
                border-radius: 0;
            }
        }
    </style>
</head>
<body class="template template7">
<header class="navbar">
    <a href="/" class="logo">ResumeHub</a>

    <nav>
        <% if (user && user.role === "admin") { %>
            <a href="/admin">Admin Dashboard</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/resumes">All Resumes</a>
            <a href="/ats">ATS Checker</a>
            <a href="/auth/logout">Logout</a>
        <% } else { %>
            <a href="/">Home</a>
            <a href="/resume/create">Create New</a>
            <a href="/dashboard">My Resumes</a>
            <a href="/ats">ATS Checker</a>
            <a href="/auth/logout">Logout</a>
        <% } %>
    </nav>
</header>


<div class="template7-resume main-resume-container">
    <!-- TOP HEADER -->
    <div class="t7-header">
        <h1><%= resume.name %></h1>
        <h2><%= resume.role %></h2>
    </div>

    <div class="t7-body">
        <!-- LEFT COLUMN -->
        <aside class="t7-left">
            <!-- CONTACT -->
            <section>
                <div class="t7-section-title">CONTACT</div>
                <div class="t7-divider"></div>
                <% if (resume.email) { %>
                    <div class="t7-contact-line"><%= resume.email %></div>
                <% } %>
                <% if (resume.phone) { %>
                    <div class="t7-contact-line"><%= resume.phone %></div>
                <% } %>
                <% if (resume.address) { %>
                    <div class="t7-contact-line"><%= resume.address %></div>
                <% } %>
                <% if (resume.linkedin) { %>
                    <div class="t7-contact-line"><%= resume.linkedin %></div>
                <% } %>
            </section>

            <!-- EDUCATION -->
            <section style="margin-top: 22px;">
                <div class="t7-section-title">EDUCATION</div>
                <div class="t7-divider"></div>
                <% if (resume.education && resume.education.trim().length > 0) { %>
                    <div class="t7-edu-degree"><%= resume.education %></div>
                <% } else { %>
                    <div class="t7-contact-line">Education details not provided.</div>
                <% } %>
            </section>

            <!-- SKILLS -->
            <section style="margin-top: 22px;">
                <div class="t7-section-title">SKILLS</div>
                <div class="t7-divider"></div>
                <% if (resume.skills && resume.skills.trim().length > 0) { %>
                    <ul class="t7-skill-list">
                        <% resume.skills.split(",").forEach(skill => { %>
                            <% if (skill.trim().length > 0) { %>
                                <li><%= skill.trim() %></li>
                            <% } %>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="t7-contact-line">Skills not specified.</div>
                <% } %>
            </section>
        </aside>

        <!-- RIGHT COLUMN -->
        <main class="t7-right">
            <!-- SUMMARY (ATS-friendly) -->
            <section style="margin-bottom: 18px;">
                <div class="t7-section-title">SUMMARY</div>
                <div class="t7-right-top-divider"></div>
                <p class="t7-summary-text">
                    <% if (resume.summary && resume.summary.trim().length > 0) { %>
                        <%= resume.summary %>
                    <% } else if (resume.skills && resume.skills.trim().length > 0) { %>
                        <%= resume.role %> skilled in <%= resume.skills %>. Focused on delivering high-quality work and continuously improving my professional capabilities.
                    <% } else { %>
                        <%= resume.role %> focused on delivering high-quality work and continuously improving my professional capabilities.
                    <% } %>
                </p>
            </section>

            <!-- WORK EXPERIENCE -->
            <section>
                <div class="t7-section-title">WORK EXPERIENCE</div>
                <div class="t7-right-top-divider"></div>

                <% if (resume.experience1) { %>
                    <div class="t7-exp-block">
                        <h3>Experience 1</h3>
                        <p class="t7-job-meta">Main responsibilities & achievements:</p>
                        <ul>
                            <% resume.experience1.split('\n').forEach(line => { %>
                                <% if (line.trim().length > 0) { %>
                                    <li><%= line.trim() %></li>
                                <% } %>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <% if (resume.experience2) { %>
                    <div class="t7-exp-block">
                        <h3>Experience 2</h3>
                        <p class="t7-job-meta">Main responsibilities & achievements:</p>
                        <ul>
                            <% resume.experience2.split('\n').forEach(line => { %>
                                <% if (line.trim().length > 0) { %>
                                    <li><%= line.trim() %></li>
                                <% } %>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <% if (resume.experience3) { %>
                    <div class="t7-exp-block">
                        <h3>Experience 3</h3>
                        <p class="t7-job-meta">Main responsibilities & achievements:</p>
                        <ul>
                            <% resume.experience3.split('\n').forEach(line => { %>
                                <% if (line.trim().length > 0) { %>
                                    <li><%= line.trim() %></li>
                                <% } %>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <% if (!resume.experience1 && !resume.experience2 && !resume.experience3) { %>
                    <p style="font-size:0.9rem; color:#444;">
                        Work experience details not provided.
                    </p>
                <% } %>
            </section>

            <!-- PROJECTS / CERTIFICATIONS -->
            <% if (resume.projects && resume.projects.trim().length > 0) { %>
                <section style="margin-top: 20px;">
                    <div class="t7-section-title">PROJECTS / CERTIFICATIONS</div>
                    <div class="t7-right-top-divider"></div>
                    <ul>
                        <% resume.projects.split('\n').forEach(line => { %>
                            <% if (line.trim().length > 0) { %>
                                <li><%= line.trim() %></li>
                            <% } %>
                        <% }) %>
                    </ul>
                </section>
            <% } %>
        </main>
    </div>
</div>

<a href="/resume/<%= id %>/download" class="download-button-ui">Download as PDF</a>
</body>
</html>
