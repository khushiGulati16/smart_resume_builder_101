<!DOCTYPE html>
<html>
<head>
    <title>Smart Resume Builder</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a, #1e293b);
            --text-light: #f1f5f9;
            --muted: #cbd5e1;
            --accent: #6366f1;
            --accent-glow: #8b5cf6;
            --card-bg: rgba(30, 41, 59, 0.7);
            --shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
            --radius: 16px;
            --font: 'Poppins', 'Segoe UI', sans-serif;
        }

        body.main-page {
            font-family: var(--font);
            background: var(--bg-gradient);
            color: var(--text-light);
            padding-top: 80px;
            margin: 0;
        }

        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            box-shadow: var(--shadow);
            z-index: 1000;
        }
        .navbar .logo {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--accent);
            text-decoration: none;
        }
        .navbar nav a {
            margin-left: 2rem;
            font-weight: 500;
            text-decoration: none;
            color: var(--text-light);
            position: relative;
            transition: color 0.3s ease;
        }
        .navbar nav a:hover {
            color: var(--accent);
        }
        .navbar nav a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -4px;
            width: 0;
            height: 2px;
            background: var(--accent);
            transition: width 0.3s ease;
        }
        .navbar nav a:hover::after {
            width: 100%;
        }

        .nav-btn {
            padding: 0.5rem 1.2rem;
            border-radius: 8px;
            font-weight: 600 !important;
            margin-left: 1.5rem !important;
            border: 1px solid rgba(255,255,255,0.2);
            transition: all 0.3s ease !important;
        }
        .nav-btn::after {
            display: none !important;
        }
        .nav-btn:hover {
            background: rgba(255,255,255,0.1);
            color: var(--text-light) !important;
        }
        
        .nav-btn-primary {
            background: linear-gradient(45deg, var(--accent), var(--accent-glow));
            border: none;
            color: #fff !important;
            box-shadow: 0 4px 15px rgba(99,102,241,0.4);
        }
        .nav-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139,92,246,0.6);
            background: linear-gradient(45deg, var(--accent), var(--accent-glow)) !important;
            color: #fff !important;
        }

        .hero-section {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            text-align: center;
            padding: 8rem 2rem 6rem;
            min-height: 90vh;
            background: radial-gradient(circle at top left, #1e293b, #0f172a);
        }
        .hero-headline {
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: 800;
            background: linear-gradient(90deg, var(--accent), var(--accent-glow));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
        }
        .hero-subheading {
            font-size: 1.2rem;
            max-width: 750px;
            color: var(--muted);
            margin: 0 auto 2.5rem;
        }
        .hero-cta-button {
            padding: 1rem 2.8rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.1rem;
            color: #fff;
            background: linear-gradient(45deg, var(--accent), var(--accent-glow));
            box-shadow: 0 5px 25px rgba(99,102,241,0.5);
            text-decoration: none;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .hero-cta-button:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(139,92,246,0.6);
        }

        .section-heading {
            text-align: center;
            font-size: clamp(2rem, 4vw, 2.8rem);
            font-weight: 700;
            background: linear-gradient(90deg, var(--accent), var(--accent-glow));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 3.5rem;
        }

        .features-section {
            padding: 6rem 2rem;
        }
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2.5rem;
            max-width: 1200px;
            margin: auto;
        }
        .feature-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 2.5rem;
            text-align: center;
            box-shadow: var(--shadow);
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }
        .feature-card:hover {
            transform: translateY(-12px) scale(1.02);
            box-shadow: 0 15px 40px rgba(0,0,0,0.6);
        }
        .feature-icon {
            font-size: 2.8rem;
            color: var(--accent);
            margin-bottom: 1.2rem;
        }
        .feature-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 0.6rem;
            color: #f8fafc;
        }
        .feature-card p {
            color: #cbd5e1;
            font-size: 1rem;
        }

        .testimonials-section {
            padding: 6rem 2rem;
            background: linear-gradient(135deg, #111827, #1f2937);
        }
        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2.5rem;
            max-width: 1000px;
            margin: auto;
        }
        .testimonial-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 2.5rem;
            box-shadow: var(--shadow);
            font-style: italic;
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }
        .testimonial-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 35px rgba(0,0,0,0.7);
        }
        .testimonial-card p {
            font-size: 1rem;
            line-height: 1.7;
            color: var(--muted);
        }
        .author {
            margin-top: 1.2rem;
            font-style: normal;
            font-weight: 600;
            color: var(--accent);
        }

        .how-it-works-section {
            padding: 6rem 2rem;
            background: rgba(15, 23, 42, 0.4);
        }
        .steps-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 2rem;
            max-width: 1000px;
            margin: auto;
        }
        .step-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 2rem;
            flex: 1;
            min-width: 250px;
            text-align: center;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255,255,255,0.05);
            position: relative;
        }
        .step-number {
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(45deg, var(--accent), var(--accent-glow));
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.2rem;
            box-shadow: 0 4px 15px rgba(99,102,241,0.5);
        }
        .step-card h3 {
            margin-top: 1.5rem;
            font-size: 1.3rem;
            color: #f8fafc;
        }
        .step-card p {
            color: var(--muted);
            margin-top: 0.5rem;
        }

        .footer {
            text-align: center;
            padding: 2rem;
            background: rgba(15,23,42,0.85);
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: 3rem;
            font-size: 0.95rem;
            color: var(--muted);
        }

        #online-users-banner {
            text-align: center;
            margin-top: 0.5rem;
            font-size: 0.9rem;
            color: var(--muted);
        }
    </style>
</head>
<body class="main-page">
<header class="navbar">
    <a href="/" class="logo">ResumeHub</a>

    <nav>
        <a href="/">Home</a>
        <a href="/auth/login" class="nav-btn">Login</a>
        <a href="/auth/signup" class="nav-btn nav-btn-primary">Sign Up</a>
    </nav>
</header>



    <div id="online-users-banner">
        Online users right now: <span id="online-count">0</span>
    </div>

    <section class="hero-section">
        <h1 class="hero-headline">Create Resumes that Get You Hired 🚀</h1>
        <p class="hero-subheading">Choose from modern, professional templates. Customize in minutes and download instantly.</p>
        <a href="/auth/signup" class="hero-cta-button">Get Started</a>
    </section>

    <section class="features-section">
        <h2 class="section-heading">Why Choose Our Builder?</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">✨</div>
                <h3 class="feature-title">Sleek, Modern Templates</h3>
                <p>Stand out with visually stunning, professional resume designs.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <h3 class="feature-title">Blazing Fast Generation</h3>
                <p>Create a job-ready resume in just a few clicks with ease.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔒</div>
                <h3 class="feature-title">Secure & Private</h3>
                <p>Your resumes and personal data stay encrypted and safe.</p>
            </div>
        </div>
    </section>

    <section class="how-it-works-section">
        <h2 class="section-heading">How It Works</h2>
        <div class="steps-container">
            <div class="step-card">
                <div class="step-number">1</div>
                <h3>Sign Up</h3>
                <p>Create your free account to securely save your resumes.</p>
            </div>
            <div class="step-card">
                <div class="step-number">2</div>
                <h3>Enter Details</h3>
                <p>Fill out our easy form with your experience, education, and skills.</p>
            </div>
            <div class="step-card">
                <div class="step-number">3</div>
                <h3>Pick Template</h3>
                <p>Select from 10+ professional and eye-catching designs.</p>
            </div>
            <div class="step-card">
                <div class="step-number">4</div>
                <h3>Download PDF</h3>
                <p>Instantly export your stunning resume and land that interview!</p>
            </div>
        </div>
    </section>

    <section class="testimonials-section">
        <h2 class="section-heading">What Users Say</h2>
        <div class="testimonials-grid">
            <div class="testimonial-card">
                <p>"This builder changed the game for me! Got an interview within a week."</p>
                <div class="author">- Jane Doe, Senior Designer</div>
            </div>
            <div class="testimonial-card">
                <p>"Templates are modern and professional. The PDF download works perfectly every time."</p>
                <div class="author">- John Smith, Software Engineer</div>
            </div>
        </div>
    </section>

    <footer class="footer">
        <p>&copy; 2025 Smart Resume Builder. All rights reserved.</p>
    </footer>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();
      socket.on("online:count", (count) => {
        const span = document.getElementById("online-count");
        if (span) span.textContent = count;
      });
    </script>
</body>
</html>
